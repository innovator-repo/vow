<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vow_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vow_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vow_widget_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/vow_widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vow_widget_reclaimed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/vow_widget_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/vow_widget_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/vow_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/vow_widget_switch"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:contentDescription="Focus switch"
        android:scaleType="center"
        android:src="@drawable/vow_switch_off" />
</LinearLayout>
